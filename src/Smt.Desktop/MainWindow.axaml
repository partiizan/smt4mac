<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Smt.Desktop"
 x:Class="Smt.Desktop.MainWindow" Title="SMT4Mac" Width="1560" Height="1000" MinWidth="1280" MinHeight="850" Background="#0A111B">
 <Grid RowDefinitions="76,*,36">
  <Border BorderBrush="#243143" BorderThickness="0,0,0,1" Padding="24,16">
   <Grid ColumnDefinitions="250,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
     <Border Background="#173C3A" CornerRadius="9" Width="38" Height="38"><TextBlock Text="S" FontWeight="Bold" FontSize="25" Foreground="#55DFC5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel><TextBlock Text="SMT4Mac" FontWeight="Bold" FontSize="17" LetterSpacing="2"/><TextBlock Text="NEW EDEN INTELLIGENCE" Classes="caption" FontSize="9"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Your region. In focus." FontSize="19" FontWeight="SemiBold"/><TextBlock Name="DataSummary" Classes="muted" FontSize="11"/></StackPanel>
    <Border Grid.Column="2" Background="#23302A" CornerRadius="5" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="EXPERIMENTAL · 0.15.0" Foreground="#C8D797" FontSize="10" LetterSpacing="1"/></Border>
   </Grid>
  </Border>
  <Grid Name="Workspace" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="480"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300" MinWidth="240" MaxWidth="480"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300" MinWidth="260" MaxWidth="480"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="400"/><RowDefinition Height="8"/><RowDefinition Height="38"/><RowDefinition Height="330" MinHeight="280"/></Grid.RowDefinitions>
   <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="18,10" Spacing="6">
     <WrapPanel><ComboBox Name="RegionPicker" Width="190" Margin="0,0,8,4"/><ComboBox Name="AdmFilterPicker" Width="180" Margin="0,0,8,4"/>
      <CheckBox Name="ShowAdm" Content="ADM" IsChecked="True" Margin="0,0,8,0"/><Button Name="ZoomOut" Content="−"/><Button Name="ZoomIn" Content="+"/><Button Name="FitMap" Content="Fit"/>
      <Button Name="ImportBridges" Content="Ansiblex CSV…" Margin="8,0,0,4" ToolTip.Tip="Import known links; green lines show connections, not verified access."/>
      <Button Name="ClearBridges" Content="Clear links" Margin="4,0,0,4"/>
     </WrapPanel>
     <TextBlock Name="RegionTitle" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Name="RegionSubtitle" Classes="muted" FontSize="11"/>
     <TextBlock Name="AdmFilterSummary" Classes="muted" FontSize="11"/>
     <TextBlock Name="BridgeStatus" Classes="muted" FontSize="10"/>
    </StackPanel>
    <local:StarMap Name="Map" Grid.Row="1" ClipToBounds="True"/>
    <StackPanel Grid.Row="2" Margin="22,8" Spacing="5">
     <WrapPanel><TextBlock Name="SystemName" Text="Select a system" FontWeight="Bold" Margin="0,0,12,0"/><TextBlock Name="SystemInfo" Classes="muted" FontSize="11"/><TextBlock Name="AdmDetails" Foreground="#55DFC5" FontSize="11" Margin="12,0,0,0"/></WrapPanel>
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Drag to pan · Scroll to zoom · Click to inspect" Classes="muted" FontSize="11"/><TextBlock Name="MapMode" Grid.Column="1" Text="ADM · PUBLIC ESI" Classes="caption" FontSize="9"/></Grid>
     <Grid ColumnDefinitions="*,Auto"><TextBlock Name="AdmStatus" Text="Connecting to public ESI…" FontSize="10" Foreground="#8C9CB0" VerticalAlignment="Center"/><Button Name="RefreshAdm" Grid.Column="1" Content="Check ADM" FontSize="10" Padding="8,3"/></Grid>
    </StackPanel>
   </Grid>
   <Border Name="IntelPanel" Grid.Column="2" BorderBrush="#243143" BorderThickness="1,0,0,0" Padding="12">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
     <StackPanel Spacing="7"><TextBlock Text="Intel stream" FontSize="20" FontWeight="SemiBold"/><TextBlock Name="IntelState" Text="Automatically locating EVE chat logs…" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
      <Expander Header="Log settings &amp; diagnostics" FontSize="11"><StackPanel Spacing="6">      <TextBlock Name="IntelDiagnostics" Text="Waiting for first scan…" FontSize="11" TextWrapping="Wrap" Foreground="#C5D6E8"/>
      <Button Name="ChooseLogs" Content="Change log folder…" HorizontalAlignment="Stretch"/>
      <Button Name="AutoLogs" Content="Use automatic EVE folder" HorizontalAlignment="Stretch"/>
      <Button Name="ChooseChannels" Content="Select intel channels…" HorizontalAlignment="Stretch"/>
      <TextBlock Name="ChannelSummary" TextWrapping="Wrap" FontSize="11"/>
      <TextBlock Text="Reports expire from the map after 15 minutes. Only selected channels are ingested." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
</StackPanel></Expander>
     </StackPanel>
     <StackPanel Grid.Row="2"><CheckBox Name="ShowIntelKills" Content="Include regional kills (24h)" FontSize="11"/><TextBlock Name="KillIntelStatus" FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel>
     <TextBlock Grid.Row="3" Name="IntelCount" Text="0 REPORTS" Classes="caption" Margin="0,20,0,10"/>
     <ListBox Grid.Row="4" Name="IntelList" Background="Transparent" Padding="0">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,6" Spacing="5"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="#E4EDF6" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Body}" Foreground="#A6B5C8" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Meta}" Foreground="#77899F" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="5" Spacing="6" Margin="0,8,0,0"><TextBlock Text="SEARCH INTEL HISTORY" Classes="caption"/><TextBox Name="IntelSearch" Watermark="Player, keyword or system…"/><TextBlock Text="Search retained history (up to 5,000 messages). Alerts use the full feed." FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel>
    </Grid>

   </Border>

   <Border Name="MonitorPanel" Grid.Column="4" BorderBrush="#243143" BorderThickness="1,0,0,0" Padding="12">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="10">
      <TextBlock Text="Local monitor" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Name="PrimaryClientLabel" FontWeight="Bold" TextWrapping="Wrap"/>
      <TextBlock Name="MonitorLocation" Text="Set your current system in settings" FontSize="11" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Text="LOCAL" Classes="caption"/>
      <Border Name="TrafficLight" Background="#364354" CornerRadius="6" Padding="12"><TextBlock Name="AlertTitle" Text="MONITORING UNAVAILABLE" FontWeight="Bold" TextWrapping="Wrap"/></Border>
      <TextBlock Name="AlertDetail" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
      <TextBlock Text="EXTENDED AREA · 3 JUMPS + CONSTELLATION" FontSize="10" TextWrapping="Wrap" Classes="muted"/>
      <Border Name="NearbyTag" IsVisible="True" Background="#D0A62C" CornerRadius="6" Padding="12">
       <StackPanel Spacing="5"><TextBlock Name="NearbyTitle" Text="ALL CLEAR" TextWrapping="Wrap" FontWeight="Bold" Foreground="#141B24"/><TextBlock Name="NearbyDetail" FontSize="11" TextWrapping="Wrap" Foreground="#141B24"/></StackPanel>
      </Border>
      <TextBlock Text="LIVE LOCAL PREVIEW" Classes="caption" Margin="0,6,0,0"/>
      <Border Background="#05090F" CornerRadius="6" MinHeight="100" MaxHeight="260" Padding="6">
       <Grid><Image Name="LocalPreview" Stretch="Uniform" MaxHeight="248"/><TextBlock Name="PreviewPlaceholder" Text="Start Local monitoring to see your selected area" Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/></Grid>
      </Border>
      <TextBlock Name="CaptureStatus" FontSize="10" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Name="TriggerDetail" FontSize="11" Foreground="#FFABB4" TextWrapping="Wrap" IsVisible="False"/>
      <Button Name="MonitorSetup" Content="Local monitor &amp; alert settings…" FontSize="11" HorizontalAlignment="Stretch"/>
      <Button Name="AddMonitor" Content="+ Add EVE client monitor" HorizontalAlignment="Stretch"/>
      <StackPanel Name="ExtraMonitors"/>
      <Border BorderBrush="#243143" BorderThickness="0,1,0,0" Padding="0,12,0,0">
       <StackPanel Spacing="7"><TextBlock Text="ALERT CONDITIONS" Classes="caption"/><TextBlock Text="Green · Local clear" Foreground="#65D7A4" FontSize="11"/><TextBlock Text="Yellow · Threats nearby" Foreground="#EAC65A" FontSize="11"/><TextBlock Text="Red · Immediate local threat" Foreground="#FF8F9E" FontSize="11"/><TextBlock Text="Visible roster only. Status updates automatically. Keep the selected Local window fixed." TextWrapping="Wrap" Classes="muted" FontSize="10"/></StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Border Name="MonitorDivider" Grid.Column="3" Cursor="SizeWestEast" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#243143"/>
   <GridSplitter Name="IntelDivider" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#243143"/>
   <Button Name="ToggleWormholes" Grid.Row="2" Grid.ColumnSpan="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="▼ Wormholes &amp; live feeds · click to minimize"/>
   <Border Name="WormholeDivider" Grid.ColumnSpan="5" Grid.Row="1" Cursor="SizeNorthSouth" HorizontalAlignment="Stretch" Background="#243143"/>
   <Border Name="LivePanel" Grid.ColumnSpan="5" Grid.Row="3" BorderBrush="#243143" BorderThickness="0,1,0,0" Padding="14,10">
    <Grid ColumnDefinitions="*,220">
     <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,14,0">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Live · Thera / Turnur connections" FontSize="18" FontWeight="SemiBold"/><Button Grid.Column="1" Name="EveScoutLink" Content="Eve-Scout ↗" FontSize="11" Padding="8,5"/></Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,130" Margin="0,8"><TextBox Name="WormholeSearch" Watermark="Search destination, region or signature…" FontSize="12"/><ComboBox Grid.Column="1" Name="WormholeHub" HorizontalAlignment="Stretch" Margin="8,0,0,0" FontSize="12"/></Grid>
      <Grid Grid.Row="2" ColumnDefinitions="74,*,146,78,80,122" Margin="10,0,10,6">
       <TextBlock Text="HUB" Classes="caption"/><TextBlock Grid.Column="1" Text="DESTINATION / REGION" Classes="caption" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="SIGNATURES" Classes="caption"/><TextBlock Grid.Column="3" Text="MAX SIZE" Classes="caption"/><TextBlock Grid.Column="4" Text="EXPIRES" Classes="caption"/><TextBlock Grid.Column="5" Text="ACTIONS" Classes="caption"/>
      </Grid>
      <Grid Grid.Row="3">
       <ListBox Name="WormholeList" Background="Transparent" Padding="0">
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#243143" BorderThickness="0,0,0,1" Padding="0,9">
         <Grid ColumnDefinitions="74,*,146,78,80,122">
          <Border Background="#28304C" CornerRadius="5" Padding="5" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Hub}" FontSize="11" Foreground="#D9B6FF"/></Border>
          <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,8,0"><TextBlock Text="{Binding System}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Location}" FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Signatures}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding Expiry}" Foreground="{Binding ExpiryColor}" ToolTip.Tip="{Binding Details}" FontSize="11" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Button Content="Map" IsEnabled="{Binding CanMap}" Click="ShowWormhole" Padding="8,6" FontSize="11" ToolTip.Tip="Show destination on map"/><Button Content="Copy" Click="CopyWormhole" Padding="8,6" FontSize="11" ToolTip.Tip="Copy both signatures and connection details"/></StackPanel>
         </Grid>
        </Border></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Name="WormholeEmpty" Text="Connecting to Eve-Scout…" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,6,0,0" Spacing="2"><TextBlock Name="WormholeCount" Classes="muted" FontSize="10"/><TextBlock Name="WormholeStatus" Classes="muted" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="Verify expiry, mass and ship restrictions in game. Times are estimates." Classes="muted" FontSize="10"/></StackPanel>
     </Grid>
     <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <TextBlock Grid.Row="0" Text="METALIMINAL STORMS" Classes="caption"/>
      <ListBox Grid.Row="1" Name="StormList" FontSize="11" Background="Transparent" Margin="0,5"/>
      <TextBlock Grid.Row="2" Name="FeedStatus" Text="Connecting…" FontSize="9" Classes="muted" TextWrapping="Wrap"/>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#243143" BorderThickness="0,1,0,0" Padding="18,8"><Grid ColumnDefinitions="*,Auto"><TextBlock Name="Status" Text="Ready" FontSize="10" Foreground="#9AAABD"/><TextBlock Grid.Column="1" Text="Unofficial SMT prototype · Local intel · Public live feeds" FontSize="10" Foreground="#77899F"/></Grid></Border>
 </Grid>
</Window>
