<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Smt.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8C9CB0"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#8C9CB0"/><Setter Property="FontSize" Value="10"/><Setter Property="LetterSpacing" Value="1.8"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12,9"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#55DFC5"/><Setter Property="Foreground" Value="#081D1B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="#111D2A"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#111D2A"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="14"/></Style>
  </Application.Styles>
</Application>
